# Скопируйте в .env и заполните своими значениями.
# Оба бота могут быть одним и тем же ботом, если рассылка и мост — один бот.

# Токен бота, который рассылает утренний дайджест (из @BotFather)
TG_BOT_TOKEN=

# Токен бота, через который идёт общение и команда «сделай пост»
TELEGRAM_BOT_TOKEN=

# chat_id владельца (узнать: @userinfobot). Скрипты принимают сообщения только с этого chat_id
TG_CHAT_ID=